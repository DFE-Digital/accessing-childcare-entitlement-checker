@using Dfe.Acec.Web.Models.Summary
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SummaryListViewModel

<govuk-summary-list>
    @foreach (var row in Model.Rows)
    {
        <govuk-summary-list-row>
            <govuk-summary-list-row-key>@Localizer[row.Key]</govuk-summary-list-row-key>
            @if (row.MaskValueForClarity)
            {
                <govuk-summary-list-row-value
                    data-clarity-mask="true"
                    data-testid="parental-leave-child-names">
                    @row.Value
                </govuk-summary-list-row-value>
            }
            else
            {
                <govuk-summary-list-row-value>
                    @row.Value
                </govuk-summary-list-row-value>
            }
            <govuk-summary-list-row-actions>
                @if (Model.IsUserDetails)
                {
                    <govuk-summary-list-row-action
                        asp-controller="Summary"
                        asp-action="ChangeUserAnswer"
                        asp-route-changeController="@row.ChangeController"
                        asp-route-changeAction="@row.ChangeAction"
                        asp-route-returnTo="@ReturnTo.CheckAnswers"
                        visually-hidden-text="@row.ChangeText">
                        @Localizer["Change"]
                    </govuk-summary-list-row-action>
                }
                else
                {
                    <govuk-summary-list-row-action
                        asp-controller="@row.ChangeController"
                        asp-action="@row.ChangeAction"
                        asp-route-returnTo="@ReturnTo.CheckAnswers"
                        visually-hidden-text="@row.ChangeText">
                        @Localizer["Change"]
                    </govuk-summary-list-row-action>
                }
            </govuk-summary-list-row-actions>
        </govuk-summary-list-row>
    }
</govuk-summary-list>
