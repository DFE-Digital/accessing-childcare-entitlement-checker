@using Microsoft.AspNetCore.Mvc.Localization
@using Dfe.Acec.Web.Models.BornChildDetails
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Shared
@inject IViewLocalizer Localizer
@model ChildBirthDateViewModel

@{
    ViewData["Title"] = Localizer["Title"];
}

@section BeforeContent {
    <govuk-back-link href="@Model.BackLink">
        @Shared["Button_Back"]
    </govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">
            @Localizer["Title", Model.ChildName]
        </h1>

        <p class="govuk-body">
            @Localizer["Details_Text"]
        </p>

        <form method="post" asp-route-childId="@Model.ChildId" asp-antiforgery="true" novalidate>
            <input type="hidden" asp-for="ReturnTo" />
            <govuk-date-input for="ChildBirthDate">
                <govuk-date-input-fieldset>
                    <govuk-date-input-fieldset-legend class="govuk-visually-hidden">
                        @Localizer["Heading", Model.ChildName]
                    </govuk-date-input-fieldset-legend>

                    <govuk-date-input-error-message />
                </govuk-date-input-fieldset>
            </govuk-date-input>

            <govuk-button type="submit">
                @Shared["Button_Continue"]
            </govuk-button>
        </form>
    </div>
</div>
