@using Dfe.Acec.Web.Models.ExpectedChildDetails
@using Microsoft.AspNetCore.Mvc.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Shared
@inject IViewLocalizer Localizer
@model ChildDueDateViewModel

@{
    ViewData["Title"] = Localizer["What is this child's due date?"];
}

@section BeforeContent {
    <govuk-back-link href="@Model.BackLink">
        @Shared["Button_Back"]
    </govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">
            @Localizer["What is this child's due date?"]
        </h1>

        <p class="govuk-body">
            @Localizer["We use this date to give you accurate results, including when you may be able to apply and when your childcare support could start and end."]
        </p>

        <form method="post" asp-route-childId="@Model.ChildId" asp-antiforgery="true" novalidate>
            <input type="hidden" asp-for="ReturnTo" />
            <govuk-date-input for="ChildDueDate">
                <govuk-date-input-fieldset>
                    <govuk-date-input-fieldset-legend class="govuk-visually-hidden" data-clarity-mask="true" >
                        @Localizer["What is this child's due date?"]
                    </govuk-date-input-fieldset-legend>

                    <govuk-date-input-error-message />
                </govuk-date-input-fieldset>
            </govuk-date-input>

            <govuk-button type="submit">
                @Shared["Button_Continue"]
            </govuk-button>
        </form>
    </div>
</div>
