@using Dfe.Acec.Web.Models.Summary
@using Microsoft.AspNetCore.Mvc.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Shared
@inject IViewLocalizer Localizer
@model CheckAnswersViewModel

@{
    ViewData["Title"] = Localizer["Title"];
}

@section BeforeContent {
    <govuk-back-link href="@Model.BackLink">
        @Shared["Button_Back"]
    </govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <partial name="_RemovedChildrenNotification" model="Model.RemovedChildNames" />

        @if (TempData["RemovedChildName"] is string removedChildName)
        {
            <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
                <div class="govuk-notification-banner__header">
                    <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">@Localizer["Notification_Success"]</h2>
                </div>
                <div class="govuk-notification-banner__content">
                    <h3 class="govuk-notification-banner__heading" data-clarity-mask="true">@Localizer["Notification_ChildRemoved", removedChildName]</h3>
                </div>
            </div>
        }

        <h1 class="govuk-heading-l">@Localizer["Title"]</h1>

        <h2 class="govuk-heading-m">@Localizer["Heading_Children"]</h2>

        @if (!Model.HasChildren)
        {
            <p class="govuk-body">
                @Localizer["Info_NoChildren"]
            </p>

            <p class="govuk-body">
                @Localizer["Info_AddChildToContinue"]
            </p>

            <div class="govuk-!-margin-bottom-4">
                <govuk-button-link class="govuk-button--secondary" asp-controller="Introduction" asp-action="ChildName" asp-route-returnTo="@ReturnTo.CheckAnswers">
                    @Localizer["Button_AddAnotherChild"]
                </govuk-button-link>
            </div>
        }
        else
        {
            @foreach (var item in Model.Children)
            {
                <partial name="_ChildSummaryCard" model="item"/>
            }

            <div class="govuk-!-margin-bottom-4">
                <govuk-button-link class="govuk-button--secondary" asp-controller="Introduction" asp-action="ChildName" asp-route-returnTo="@ReturnTo.CheckAnswers">
                    @Localizer["Button_AddAnotherChild"]
                </govuk-button-link>
            </div>

            <h2 class="govuk-heading-m">@Localizer["Heading_UserDetails"]</h2>
            <partial name="_SummaryList" model="Model.UserDetails" />

            @if (Model.PartnerDetails.Any())
            {
                <h2 class="govuk-heading-m">@Localizer["Heading_PartnerDetails"]</h2>
                <partial name="_SummaryList" model="Model.PartnerDetails" />
            }

            <p class="govuk-body">@Localizer["Info_ContinueToResults"]</p>

            <govuk-inset-text>
                @Localizer["Info_NotAnApplication"]
            </govuk-inset-text>

            <div class="govuk-!-margin-top-3">
                <form asp-controller="Summary" asp-action="CheckAnswers" method="post">
                    <input type="hidden" asp-for="CorrelationId"/>
                    <govuk-button type="submit">@Shared["Button_Continue"]</govuk-button>
                </form>
            </div>
        }
    </div>
</div>
