@using Dfe.Acec.Web.Controllers
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.FeatureManagement
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Shared
@inject IViewLocalizer Localizer
@inject IFeatureManager FeatureManager

@{
    var title = "Check if you are eligible for childcare funding";
    ViewData["Title"] = Localizer[title];
}

@section BeforeContent {
    @if (await FeatureManager.IsEnabledAsync(FeatureFlags.HmrcIntegration))
    {
        <govuk-back-link href="https://www.tax.service.gov.uk/childcare-calc/location">
            @Shared["Button_Back"]
        </govuk-back-link>
    }
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">
            @Localizer[title]
        </h1>

        <p class="govuk-body">
            @Localizer["Use this service to check what childcare support you could get if you live in England."]
        </p>

        <p class="govuk-body">
            @Localizer["This includes:"]
        </p>

        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["funded childcare for children aged between 9 months and 4 years"]</li>
            <li>@Localizer["help with childcare costs for children up to 16 years old"]</li>
        </ul>

        <govuk-inset-text>
            @Localizer["This is not an application. Your answers will not be shared beyond this service."]
        </govuk-inset-text>

        <h2 class="govuk-heading-m">
            @Localizer["What you will need"]
        </h2>

        <p class="govuk-body">
            @Localizer["You will need information about you and your partner, if you live with them, including:"]
        </p>

        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["your children, including any you are expecting"]</li>
            <li>@Localizer["your nationality"]</li>
            <li>@Localizer["your employment status and income"]</li>
            <li>@Localizer["any benefits you get"]</li>
        </ul>
        
        <h2 class="govuk-heading-m">
            @Localizer["Check if you can use this service"]
        </h2>
        
        <p class="govuk-body">
            @Localizer["You should not use this service:"]
        </p>
        
        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["if you do not live in England"]</li>
            <li>@Localizer["for a child in local authority care or foster care"]</li>
            <li>@Localizer["if your child lives with you for less than half of the time"]</li>
        </ul>

        <p class="govuk-body">
            @Localizer["If you care for a child in local authority or foster care, contact the child’s social worker or fostering service for advice about childcare support."]
        </p>

        <h2 class="govuk-heading-m">
            @Localizer["If you live in Northern Ireland, Scotland or Wales"]
        </h2>

        <p class="govuk-body">
            <a class="govuk-link" href="https://www.gov.uk/childcare-calculator">@Localizer["Check what help you could get with childcare costs"]</a>.
        </p>
        
        <govuk-button-link
            asp-controller="Home"
            asp-action="@nameof(HomeController.Location)"
            is-start-button="true"
            class="govuk-!-margin-top-4 govuk-!-margin-bottom-6">

            @Localizer["Start now"]

        </govuk-button-link>
        
        
        <h2 class="govuk-heading-m">
            @Localizer["If you need help"]
        </h2>

        <p class="govuk-body">
            @Localizer["If you need help using this service or understanding what childcare support may be available, you can"]
            <a class="govuk-link" href="https://www.gov.uk/find-local-council">@Localizer["contact your local council"]</a>.
        </p>
        
    </div>
</div>
