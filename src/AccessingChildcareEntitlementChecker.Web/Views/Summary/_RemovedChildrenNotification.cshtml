@inject IViewLocalizer Localizer
@using Microsoft.AspNetCore.Mvc.Localization
@model IReadOnlyList<string>

@if (Model.Count > 0)
{
    <section class="govuk-notification-banner"
             aria-labelledby="govuk-notification-banner-title"
             data-module="govuk-notification-banner">

        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title"
                id="govuk-notification-banner-title">
                @Localizer["Important"]
            </h2>
        </div>

        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">
                @Localizer["The following children have been removed because some information was missing:"]
            </p>

            @foreach (var child in Model)
            {
                <p class="govuk-notification-banner__heading">
                    @child
                </p>
            }

            <p class="govuk-body">
                @Localizer["You will need to add them again"]
            </p>
        </div>
    </section>
}