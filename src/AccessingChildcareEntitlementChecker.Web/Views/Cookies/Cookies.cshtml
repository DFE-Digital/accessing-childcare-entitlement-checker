@using Microsoft.AspNetCore.Mvc.Localization
@using AccessingChildcareEntitlementChecker.Web.Models.Cookies;
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Shared
@inject IViewLocalizer Localizer
@model CookiesViewModel

@{
    var title = Localizer["Cookie policy"];
    ViewData["Title"] = title;
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        @if (Model.HasSetCookies ?? false)
        {
            <govuk-notification-banner type="NotificationBannerType.Success">
                <p class="govuk-notification-banner__heading">
                    @Localizer["You've set your cookie preferences."]
                </p>
            </govuk-notification-banner>
        }

        <h1 class="govuk-heading-l">
            @title
        </h1>
        
        <p class="govuk-body">
            @Localizer["This page is about the cookies on Check if you are eligible for childcare funding."]
        </p>

        
        <h2 class="govuk-heading-m">
            @Localizer["Cookies"]
        </h2>

        <p class="govuk-body">
            @Localizer["Cookies are small files saved on your phone, tablet or computer when you visit a website."]
        </p>

        <p class="govuk-body">
            @Localizer["We use cookies to make this site work and collect information about how you use our service."]
        </p>

        <h2 class="govuk-heading-m">
            @Localizer["Essential Cookies"]
        </h2>

        <p class="govuk-body">
            @Localizer["Essential cookies keep your information secure while you use Help for early years providers. We do not need to ask permission to use them."]
        </p>

        <table class="govuk-table">
            <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">@Localizer["Name"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Purpose"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Expires"]</th>
            </tr>
            </thead>
            <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["cookie_policy"]</td>
                <td class="govuk-table__cell">@Localizer["Saves your cookie consent settings"]</td>
                <td class="govuk-table__cell">@Localizer["6 months"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer[".AspNetCore.Session"]</td>
                <td class="govuk-table__cell">@Localizer["Maintains your progress through the checker"]</td>
                <td class="govuk-table__cell">@Localizer["20 hours"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer[".AspNetCore.Antiforgery.*"]</td>
                <td class="govuk-table__cell">@Localizer["Protects against CSRF attacks"]</td>
                <td class="govuk-table__cell">@Localizer["When you close your browser"]</td>
            </tr>
            </tbody>
        </table>
        
        
        
        <h2 class="govuk-heading-m">
            @Localizer["Analytics cookies (optional)"]
        </h2>
        
        <p class="govuk-body">
            @Localizer["With your permission, we use cookies for:"]
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["Google Analytics"]</li>
            <li>@Localizer["Microsoft Clarity"]</li>
        </ul>
        
        <p class="govuk-body">
            @Localizer["These help us understand how users interact with Help for early years providers and improve the service. Data collected is anonymised. Neither Google nor Microsoft are allowed to use or share our analytics data with anyone."]
        </p>
        
        <p class="govuk-body">
            @Localizer["We also send cross-domain tracking information to"]
            <a href="https://www.gov.uk/"
               class="govuk-link">
                @Localizer["GOV.UK"]
            </a>
            @Localizer["to help us understand and monitor performance data across multiple public services."]
        </p>
        
        
        <h2 class="govuk-heading-m">
            @Localizer["Google Analytics"]
        </h2>
        
        <p class="govuk-body">
            @Localizer["Google Analytics stores anonymised information about:"]
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["how you use the website"]</li>
            <li>@Localizer["which pages you visit"]</li>
            <li>@Localizer["time spent and the actions taken on pages you visit"]</li>
        </ul>
        
        <p class="govuk-body">
            @Localizer["It uses this information to create anonymised reports and insights into:"]
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["user behaviour"]</li>
            <li>@Localizer["traffic sources"]</li>
            <li>@Localizer["engagement metrics"]</li>
        </ul>
        
        
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--s">
                @Localizer["Google Analytics sets the following cookies"]
            </caption>
            <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">@Localizer["Name"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Purpose"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Expires"]</th>
            </tr>
            </thead>
            <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["_ga_F0DGNDC4S8"]</td>
                <td class="govuk-table__cell">@Localizer["Generates statistics about how you use the website"]</td>
                <td class="govuk-table__cell">@Localizer["2 years"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["_ga"]</td>
                <td class="govuk-table__cell">@Localizer["Helps count how many people visit this site by tracking if you’ve visited before"]</td>
                <td class="govuk-table__cell">@Localizer["2 years"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["_gid"]</td>
                <td class="govuk-table__cell">@Localizer["Helps count how many people visit this site by tracking if you’ve visited before"]</td>
                <td class="govuk-table__cell">@Localizer["24 hours"]</td>
            </tr>
            </tbody>
        </table>
        
        
        
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--s">
                @Localizer["Google Analytics retains data as follows"]
            </caption>
            <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">@Localizer["Google Analytics data type"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Retention period"]</th>
            </tr>
            </thead>
            <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["User Data (that is, identifiers tied to sessions and demographics.)"]</td>
                <td class="govuk-table__cell">@Localizer["14 months"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["Event Data (that is, interactions such as page views, events, and conversions.)"]</td>
                <td class="govuk-table__cell">@Localizer["14 months"]</td>
            </tr>
            </tbody>
        </table>
        
        
        <h2 class="govuk-heading-m">
            @Localizer["Microsoft Clarity"]
        </h2>
        
        <p class="govuk-body">
            @Localizer["Microsoft Clarity stores anonymised information about:"]
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["how you use the website"]</li>
            <li>@Localizer["which pages you visit"]</li>
        </ul>
        
        <p class="govuk-body">
            @Localizer["It uses this information to create anonymised:"]
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>@Localizer["recordings of sessions"]</li>
            <li>@Localizer["heatmaps"]</li>
        </ul>
        
        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--s">
                @Localizer["Microsoft Clarity sets the following cookies"]
            </caption>
            
            <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">@Localizer["Name"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Purpose"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Expires"]</th>
            </tr>
            </thead>
            <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["_clck"]</td>
                <td class="govuk-table__cell">@Localizer["Persists the Clarity User ID and preferences, unique to that site is attributed to the same user ID"]</td>
                <td class="govuk-table__cell">@Localizer["1 year"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["_clsk"]</td>
                <td class="govuk-table__cell">@Localizer["Connects multiple page views by a user into a single Clarity session recording"]</td>
                <td class="govuk-table__cell">@Localizer["24 hours"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["CLID"]</td>
                <td class="govuk-table__cell">@Localizer["Identifies the first-time Clarity saw this user on any site using Clarity"]</td>
                <td class="govuk-table__cell">@Localizer["1 year"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["ANONCHK"]</td>
                <td class="govuk-table__cell">@Localizer["Indicates whether MUID is transferred to ANID, a cookie used for advertising. Clarity doesn’t use ANID and so this is always set to 0."]</td>
                <td class="govuk-table__cell">@Localizer["10 minutes"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["MR"]</td>
                <td class="govuk-table__cell">@Localizer["Indicates whether to refresh MUID"]</td>
                <td class="govuk-table__cell">@Localizer["1 week"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["MUID"]</td>
                <td class="govuk-table__cell">@Localizer["Identifies unique web browsers visiting Microsoft sites. These cookies are used for advertising, site analytics, and other operational purposes"]</td>
                <td class="govuk-table__cell">@Localizer["25 days"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["SM"]</td>
                <td class="govuk-table__cell">@Localizer["Used in synchronising the MUID across Microsoft domains"]</td>
                <td class="govuk-table__cell">@Localizer["When you close your browser"]</td>
            </tr>

            </tbody>
        </table>
        

        <table class="govuk-table">
            <caption class="govuk-table__caption govuk-table__caption--s">
                @Localizer["Microsoft Clarity retains data as follows"]
            </caption>
            <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">@Localizer["Clarity data type"]</th>
                <th scope="col" class="govuk-table__header">@Localizer["Retention period"]</th>
            </tr>
            </thead>
            <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["Click Data (that is, data shown on the Clarity portal or aggregated data per page on the website such as the URL, user ID, and pointer distance)"]</td>
                <td class="govuk-table__cell">@Localizer["13 months"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["Playback Data (that is, the data captured for playing back recordings)"]</td>
                <td class="govuk-table__cell">@Localizer["30 days"]</td>
            </tr>
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@Localizer["Sessions labelled or favourited"]</td>
                <td class="govuk-table__cell">@Localizer["13 months"]</td>
            </tr>
            </tbody>
        </table>

        
        <form method="post" novalidate>
            <govuk-radios for="AnalyticsCookiesEnabled">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend class="govuk-fieldset__legend--s">
                        @Localizer["Do you want to accept analytics cookies?"]
                    </govuk-radios-fieldset-legend>

                    <govuk-radios-error-message />

                    <govuk-radios-item value="True">
                        @Localizer[$"Yes"]
                    </govuk-radios-item>

                    <govuk-radios-item value="False">
                        @Localizer[$"No"]
                    </govuk-radios-item>

                </govuk-radios-fieldset>
            </govuk-radios>

            <govuk-button type="submit">
                @Shared["Button_Continue"]
            </govuk-button>
        </form>
    </div>
</div>