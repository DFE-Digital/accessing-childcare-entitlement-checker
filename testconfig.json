{
  "$schema": "https://testing.microsoft.com/schemas/2024/01/testconfig.json",
  "platformOptions": {
    "resultDirectory": "./.test-results"
  },
  "commandLineOptions": {
    "report-trx": true,
    "report-gh": true,
    "report-gh-step-summary": "off"
  },
  "xUnit": {
    "culture": "en-GB",
    "parallelizeTestCollections": true
  }
}
