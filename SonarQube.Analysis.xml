<?xml version="1.0" encoding="utf-8" ?>
<SonarQubeAnalysisProperties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                             xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">
  <Property Name="sonar.host.url">https://sonarcloud.io</Property>
  <Property Name="sonar.cs.vstest.reportsPaths">.test-results/**/*.trx</Property>
  <Property Name="sonar.cs.opencover.reportsPaths">**/coverage.opencover*.xml</Property>
  <Property Name="sonar.exclusions">**/Dfe.Acec.Shutter/**,**/scripts/**,**/docs/**,**/infra/**,**/.github/**,**/.devcontainer/**,**/*.html,**/*.json,**/*.scss,**/wwwroot/**</Property>
  <Property Name="sonar.coverage.exclusions">**/Program.cs</Property>
