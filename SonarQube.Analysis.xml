  <Property Name="sonar.issue.ignore.block">e1</Property>
  <Property Name="sonar.issue.ignore.block.e1.beginBlockRegexp">sonarignore:start</Property>
  <Property Name="sonar.issue.ignore.block.e1.endBlockRegexp">sonarignore:end</Property>
  <Property Name="sonar.qualitygate.wait">true</Property>
  <Property Name="sonar.featureflag.cloud-security-enable-secrets-S8136">true</Property>
</SonarQubeAnalysisProperties>
